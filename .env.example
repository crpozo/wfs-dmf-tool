# Local development values. Copy to .env and adjust. Never commit .env.
APP_NAME="Draw My Fence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
DRAWFENCE_EMBED_PARENT_ORIGIN=http://localhost:8080

# Property map (Google Maps). Leave GOOGLE_MAPS_BROWSER_KEY empty to use the classic canvas only.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_MAP_ID=
GOOGLE_MAPS_SIGNING_SECRET=
# Bucket for the satellite image of property map quotes (EC2 instance role has access)
QUOTE_IMAGES_BUCKET=wfs-drawfence-quote-images

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=host.docker.internal
DB_PORT=5433
DB_DATABASE=wfsdb
DB_USERNAME=postgres
DB_PASSWORD=local

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Local: write emails to storage/logs/laravel.log instead of sending
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@westernfencesupply.com
MAIL_FROM_NAME="${APP_NAME}"
QUOTES_EMAIL=sales@westernfencesupply.com

# Odoo: leave the key EMPTY locally unless testing against a dev Odoo instance.
ODOO_BASE_URL=
ODOO_API_KEY=
ODOO_USR_ID=
ODOO_CUSTOMER=
